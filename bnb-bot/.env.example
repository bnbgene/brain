# Copy this file to ".env" (same folder) and fill it in. Never share .env or post it anywhere.
DISCORD_TOKEN=paste-your-bot-token-here
ANTHROPIC_API_KEY=paste-your-claude-api-key-here

# Right-click in Discord (with Developer Mode on) and "Copy ID":
WELCOME_CHANNEL_ID=
OWNER_ID=
# Channels it should never answer in, comma-separated (announcements, #applicants, etc.)
IGNORE_CHANNEL_IDS=

# Optional
WAIT_SECONDS=75
